{
    "layer": "top",
    "position": "top",
    "height": 28,
    "margin": 0,

    "modules-left": ["custom/apple", "hyprland/window"],
    "modules-center": [],
    "modules-right": ["hyprland/workspaces", "pulseaudio", "network", "battery", "clock"],

    "custom/apple": {
        "format": "",
        "tooltip": false,
        "on-click": "hyprlauncher"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 40,
        "separate-outputs": true
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-click": "pavucontrol",
        "tooltip-format": "{volume}%"
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format": "{essid} ({signalStrength}%)"
    },

    "battery": {
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-icons": ["󰁺", "󰁼", "󰁿", "󰂁", "󰁹"]
    },

    "clock": {
        "format": "{:%a %b %d   %I:%M %p}",
        "tooltip-format": "<tt>{calendar}</tt>"
    }
}
