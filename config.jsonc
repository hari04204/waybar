{
    "layer": "top",
    "position": "top",
    "height": 28,
    "margin": 0,

    "modules-left": ["custom/apple", "hyprland/window"],
    "modules-center": [],
    "modules-right": ["hyprland/workspaces", "group/volume", "network", "battery", "clock"],

    "custom/apple": {
        "format": "",
        "tooltip": false,
        "on-click": "hyprlauncher"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 40,
        "separate-outputs": true
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate"
    },
    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format": "{essid} ({signalStrength}%)"
    },

    "battery": {
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-icons": ["󰁺", "󰁼", "󰁿", "󰂁", "󰁹"]
    },

    "clock": {
        "format": "{:%a %b %d   %I:%M %p}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "group/volume": {
    "orientation": "inherit",
    "drawer": {
        "transition-duration": 300,
        "transition-left-to-right": false
    },
    "modules": ["pulseaudio", "pulseaudio/slider"]
},

"pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "tooltip-format": "{volume}%",
    "scroll-step": 5,
    "on-click": "~/.config/waybar/scripts/audio-menu.sh",
    "on-click-right": "pavucontrol"
},

"pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
}
}
